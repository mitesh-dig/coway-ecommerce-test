# hoisted linker (required for the React Native singleton resolution).
node-linker=hoisted

# The shared engine + chassis are published to GitHub Packages under @8848digital.
# This routes that scope to the registry so `pnpm install` can resolve them.
# NO auth token here — put a read token in your user-level ~/.npmrc:
#   //npm.pkg.github.com/:_authToken=YOUR_GITHUB_READ_TOKEN
@8848digital:registry=https://npm.pkg.github.com
