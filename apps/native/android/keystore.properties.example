# Android RELEASE signing credentials.
#
# Copy this file to `keystore.properties` (same folder) and fill in real values,
# OR provide the same keys as environment variables in CI. Both `keystore.properties`
# and `*.keystore` are gitignored — NEVER commit real signing secrets.
#
# 1) Generate an upload keystore (one-time):
#      keytool -genkeypair -v -storetype PKCS12 -keystore release.keystore \
#        -alias upload -keyalg RSA -keysize 2048 -validity 10000
# 2) Fill the four values below (or set them as REACTANT_UPLOAD_* env vars in CI).
# 3) Build: cd apps/native/android && ./gradlew bundleRelease

# Absolute path to the keystore file (or path relative to apps/native/android/app).
REACTANT_UPLOAD_STORE_FILE=/absolute/path/to/release.keystore
# Alias chosen when generating the keystore.
REACTANT_UPLOAD_KEY_ALIAS=upload
# Keystore + key passwords (often identical).
REACTANT_UPLOAD_STORE_PASSWORD=changeme
REACTANT_UPLOAD_KEY_PASSWORD=changeme
