{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022"],
    "jsx": "react-native",
    "strict": true,
    "moduleResolution": "node",
    "allowJs": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "types": ["jest"],
    "paths": {
      "@app/core": ["../../packages/core/src/index.ts"],
      "@app/core/*": ["../../packages/core/src/*"],
      "@app/ui-native": ["../../packages/ui-native/src/index.ts"],
      "@app/ui-native/*": ["../../packages/ui-native/src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx","**/*.d.ts"],
  "exclude": ["node_modules", "android", "ios"]
}
